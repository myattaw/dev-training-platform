<?xml version="1.0" encoding="UTF-8"?>
<!-- Library set "core" of the Spring Boot web-challenge runner (/opt/lib/core).
     Resolved once at image build; a challenge picks its set (core, jpa, security). -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.3</version>
    <relativePath/>
  </parent>
  <groupId>dev.pracstack</groupId>
  <artifactId>web-runner-core</artifactId>
  <version>1</version>
  <properties><java.version>21</java.version></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
  </dependencies>
</project>
