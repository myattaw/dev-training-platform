/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // TypeScript 6 defaults rootDir to this folder; the app also compiles packages/*/src.
    "rootDir": "../..",
    "outDir": "../../out-tsc/web-app",
    // Workspace packages are TypeScript source: compile them with the app rather than
    // as prebuilt node_modules (the dev server cannot prebundle extensionless .ts imports).
    "paths": {
      "@pracstack/*": ["../../packages/*/src/index.ts"]
    },
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/testing/**"]
}
