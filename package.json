{
  "name": "pracstack",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "services/*",
    "content"
  ],
  "scripts": {
    "start": "node scripts/dev.mjs",
    "prestart": "npm run content:build",
    "start:web": "ng serve",
    "api": "tsx services/api/src/local/server.ts",
    "api:watch": "tsx watch services/api/src/local/server.ts",
    "build": "ng build",
    "prebuild": "npm run content:build",
    "postbuild": "npm run content:check-leaks",
    "watch": "ng build --watch --configuration development",
    "content:build": "npm run build -w @pracstack/content",
    "content:check-leaks": "tsx content/scripts/check-leaks.ts dist/web/browser",
    "test": "npm run test:packages && npm run test:web",
    "test:web": "ng test --watch=false",
    "test:packages": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "ng lint && eslint packages services content e2e",
    "format": "prettier --write \"apps/web/src/**/*.{ts,html,css}\" \"packages/*/src/**/*.ts\" \"services/*/src/**/*.ts\" \"content/{src,scripts}/**/*.ts\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,html,css}\" \"packages/*/src/**/*.ts\" \"services/*/src/**/*.ts\" \"content/{src,scripts}/**/*.ts\" \"e2e/**/*.ts\"",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "monaco-editor": "0.57.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
