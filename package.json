{
  "name": "pracstack",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "services/*",
    "content",
    "infra"
  ],
  "scripts": {
    "start": "node scripts/dev.mjs",
    "prestart": "npm run content:build",
    "start:web": "ng serve",
    "api": "tsx services/api/src/local/server.ts",
    "api:watch": "tsx watch services/api/src/local/server.ts",
    "build": "ng build",
    "prebuild": "npm run content:build",
    "postbuild": "npm run content:check-leaks",
    "watch": "ng build --watch --configuration development",
    "content:build": "npm run build -w @pracstack/content",
    "content:check-leaks": "tsx content/scripts/check-leaks.ts dist/web/browser",
    "test": "npm run test:packages && npm run test:web",
    "test:web": "ng test --watch=false",
    "test:packages": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "ng lint && eslint packages services content e2e infra",
    "format": "prettier --write \"apps/web/src/**/*.{ts,html,css}\" \"packages/*/src/**/*.ts\" \"services/*/{src,scripts}/**/*.ts\" \"content/{src,scripts}/**/*.ts\" \"e2e/**/*.ts\" \"infra/{bin,lib,scripts,test}/**/*.ts\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,html,css}\" \"packages/*/src/**/*.ts\" \"services/*/{src,scripts}/**/*.ts\" \"content/{src,scripts}/**/*.ts\" \"e2e/**/*.ts\" \"infra/{bin,lib,scripts,test}/**/*.ts\"",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run check:dev-server && npm run oracle:start && npm run sqlserver:start && npm run e2e",
    "runners:build": "npm run build-images -w @pracstack/code-runner",
    "deploy:prepare": "npm run build && npm run build:lambda -w @pracstack/api && npm run build -w @pracstack/runners && npm run prepare-assets -w @pracstack/infra",
    "check:dev-server": "node scripts/check-dev-server.mjs",
    "oracle:start": "tsx scripts/oracle.mts start",
    "oracle:stop": "tsx scripts/oracle.mts stop",
    "oracle:remove": "tsx scripts/oracle.mts remove",
    "sqlserver:start": "tsx scripts/sqlserver.mts start",
    "sqlserver:stop": "tsx scripts/sqlserver.mts stop",
    "sqlserver:remove": "tsx scripts/sqlserver.mts remove",
    "web-runners:build": "npm run build-images -w @pracstack/web-runner",
    "content:check-programs": "tsx content/scripts/check-programs.ts",
    "content:check-web": "tsx content/scripts/check-web-challenges.ts"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "monaco-editor": "0.57.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "web-tree-sitter": "0.27.2"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@pracstack/web-security": "*",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.8.0",
    "eslint": "^10.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.1"
  }
}
